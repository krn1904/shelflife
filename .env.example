# Supabase project. Newer dashboards call these "publishable" and "secret";
# older ones call them "anon" and "service_role". Either naming is accepted.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses every RLS policy in this repo, so it must never be
# exposed to the browser and never committed. Rotate it if it leaks.
SUPABASE_SECRET_KEY=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Transactional email for the daily owner digest
RESEND_API_KEY=
