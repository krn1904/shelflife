# Supabase — from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser; used by seed scripts and Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the scheduled Edge Functions must present in x-cron-secret.
# Without it the expiry engine would be triggerable by anyone who knows its URL.
CRON_SECRET=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Transactional email for the daily owner digest
RESEND_API_KEY=

# Set to "true" ONLY on the public demo deployment. It enables the four one-click role
# logins and the "jump 7 days" button; leave it unset anywhere real.
NEXT_PUBLIC_DEMO_MODE=
