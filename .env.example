# Supabase — from your project's API settings.
# Supabase renamed these keys in 2025; either naming scheme works, so copy whichever
# pair your project actually shows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # newer projects use this name instead

# Server-only. Never expose to the browser; used by seed scripts and Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=                    # newer projects use this name instead

# Shared secret the scheduled Edge Functions must present in x-cron-secret.
# Without it the expiry engine would be triggerable by anyone who knows its URL.
CRON_SECRET=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Transactional email for the daily owner digest
RESEND_API_KEY=

# Set to "true" ONLY on the public demo deployment. It enables the four one-click role
# logins and the "jump 7 days" button; leave it unset anywhere real.
NEXT_PUBLIC_DEMO_MODE=

# AWS Textract, for the docket OCR test bench (/app/deliveries/docket-test).
# An IAM user with only AmazonTextractFullAccess. Not AWS_*: Vercel reserves those names.
TEXTRACT_ACCESS_KEY_ID=
TEXTRACT_SECRET_ACCESS_KEY=
TEXTRACT_REGION=ap-southeast-2
